# .env.local  (DO NOT commit)

# Whop Configuration
# IMPORTANT: WHOP_API_KEY must NEVER be exposed to the browser (no NEXT_PUBLIC_ prefix)
# This key is used only on the server-side for secure Whop API operations
WHOP_API_KEY=

# These can be public as they're used for client-side Whop iframe integration
NEXT_PUBLIC_WHOP_APP_ID=
NEXT_PUBLIC_WHOP_AGENT_USER_ID=
NEXT_PUBLIC_WHOP_COMPANY_ID=

# Site URL for OAuth redirects
NEXT_PUBLIC_SITE_URL=